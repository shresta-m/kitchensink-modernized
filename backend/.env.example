# Export these (or put them in your IDE run configuration). Never commit real values.
# MongoDB connection string. Default: local mongod without auth. Atlas example: mongodb+srv://user:pass@cluster/kitchensink
MONGODB_URI=mongodb://localhost:27017/kitchensink
# Generate with: openssl rand -base64 48
JWT_SECRET=
# First-run users (password min 12 chars). Leave blank to skip seeding.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_VIEWER_USERNAME=
BOOTSTRAP_VIEWER_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173
